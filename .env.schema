# Convoy-authored. Set these in the Vercel project before promotion.
# Do NOT commit real values.

# Postgres connection string used by Prisma at build + runtime
DATABASE_URL=postgres://user:password@host:5432/dbname?schema=public

# Next.js public base URL (used for absolute links, auth callbacks, etc.)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
